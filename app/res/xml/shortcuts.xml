<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press launcher shortcuts: the app has no address bar, so reload and
     "open in the real browser" live here. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="reload"
        android:shortcutLongLabel="@string/shortcut_reload_long"
        android:shortcutShortLabel="@string/shortcut_reload">
        <intent
            android:action="dev.dsh.pad.action.RELOAD"
            android:targetClass="dev.dsh.pad.MainActivity"
            android:targetPackage="dev.dsh.pad" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="browser"
        android:shortcutLongLabel="@string/shortcut_browser_long"
        android:shortcutShortLabel="@string/shortcut_browser">
        <intent
            android:action="dev.dsh.pad.action.BROWSER"
            android:targetClass="dev.dsh.pad.MainActivity"
            android:targetPackage="dev.dsh.pad" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="termux"
        android:shortcutLongLabel="@string/shortcut_termux_long"
        android:shortcutShortLabel="@string/shortcut_termux">
        <intent
            android:action="dev.dsh.pad.action.TERMUX"
            android:targetClass="dev.dsh.pad.MainActivity"
            android:targetPackage="dev.dsh.pad" />
    </shortcut>
</shortcuts>
